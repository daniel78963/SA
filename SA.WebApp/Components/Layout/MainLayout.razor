@* MiniSidebar *@
<div class="page">
    @* 1. Agregamos la clase "mini" dinámicamente si isMiniSidebar es true *@
    <div class="sidebar @(isMiniSidebar ? "mini" : "")">
        @* 2. Le pasamos el estado al NavMenu *@
        @* @bind- le indica a Blazor que la variable puede ser modificada desde adentro del hijo. *@
        <NavMenu3 @bind-IsMini="isMiniSidebar" />
    </div>

    <main>
        @* 3. Reacomodamos el top-row para que el botón quede a la izquierda *@
        <div class="top-row pe-4 ps-0 d-flex align-items-center">
            @* Botón de colapso para Desktop *@ 
          @*   <button class="btn btn-link text-dark " @onclick="ToggleSidebar" title="Colapsar menú">
                <i class="bi bi-list fs-4"></i>
            </button> *@ 
            <button class="btn btn-link text-dark p-0 me-auto d-none d-sm-block" @onclick="ToggleSidebar" title="Colapsar menú" style="margin-left: -6px;">
                <i class="bi bi-list fs-4"></i>
            </button>

            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
            @* <div class="sidebar"> *@
            @* <NavBarTop /> *@
            @* </div> *@

            @* CONTENEDOR DEL MENÚ HORIZONTAL (Alineado a la derecha) *@
            <div class="d-flex align-items-center justify-content-end flex-grow-1">

                @* 1. Opciones Horizontales Normales (Ejemplo) *@
                <div class="d-none d-md-flex align-items-center me-4 top-horizontal-menu">
                    <NavLink class="nav-link px-3" href="help"><i class="bi bi-question-circle me-1"></i> Ayuda</NavLink>
                    <NavLink class="nav-link px-3" href="settings"><i class="bi bi-gear me-1"></i> Ajustes</NavLink>
                </div>

                @* 2. Menú de Sesión del Usuario *@
                <AuthorizeView>
                    <Authorized>
                        @* Agregamos la clase 'dropdown' de Bootstrap *@
                        <div class="user-menu-container dropdown">

                            @* Cambiamos el @onclick por data-bs-toggle="dropdown" *@
                            <button class="btn btn-link text-dark text-decoration-none d-flex align-items-center p-0"
                                    data-bs-toggle="dropdown" aria-expanded="false" >
                                <div class="avatar-circle me-2">
                                    @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <span class="fw-bold d-none d-sm-inline">@context.User.Identity?.Name</span>
                                <i class="bi bi-chevron-down ms-2" style="font-size: 0.8rem;"></i>
                            </button>

                            @* El contenedor del submenú ahora es un <ul> con clases nativas de Bootstrap *@
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg user-dropdown-menu mt-2">
                                <li>
                                    <div class="px-4 py-3 border-bottom text-center">
                                        <p class="mb-0 fw-bold">@context.User.Identity?.Name</p>
                                        <small class="text-muted">Administrador</small>
                                    </div>
                                </li>

                                <li>
                                    <a class="dropdown-item px-4 py-2" href="Account/Manage">
                                        <i class="bi bi-person-badge me-2"></i>Datos Personales
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item px-4 py-2" href="Account/Manage/ChangePassword">
                                        <i class="bi bi-shield-lock me-2"></i>Seguridad
                                    </a>
                                </li>

                                <li><hr class="dropdown-divider"></li>

                                <li>
                                    <form action="Account/Logout" method="post">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="ReturnUrl" value="/" />
                                        <button type="submit" class="dropdown-item px-4 py-2 text-danger w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="Account/Login" class="btn btn-primary btn-sm rounded-pill px-3">Iniciar Sesión</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            <div class="py-2">@Body</div>
        </article>
    </main>
</div>

