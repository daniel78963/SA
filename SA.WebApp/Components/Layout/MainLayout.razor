@inherits LayoutComponentBase
@using SA.WebApp.State 
@inject ProductStateContainer ProductState

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // ¡Aquí ocurre la magia!
        // Al cargar la estructura principal de la web, pedimos los datos a la BD.
        // Esto actualiza el contador del menú inmediatamente.
        await ProductState.EnsureInitializedAsync();
    }
}