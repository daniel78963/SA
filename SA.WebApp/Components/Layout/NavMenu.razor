@* ÍTEM PADRE (Desplegable) *@
<div class="nav-item px-3">
    @* Usamos un div/button con @onclick en lugar de NavLink para que no navegue, solo despliegue *@
    <button class="nav-link w-100 text-start d-flex align-items-center" @onclick="ToggleProductsMenu">
       @*  <i class="bi bi-box"></i> Productos *@
        <i class="bi bi-check-circle-fill"></i> Productos
       @*  <span>Productos</span> *@
        @* La flechita gira dependiendo de si está abierto o cerrado *@
        <i class="bi bi-chevron-down ms-auto" style="transition: transform 0.3s ease; transform: @(expandProducts ? "rotate(180deg)" : "rotate(0deg)")"></i>
    </button>
</div>

