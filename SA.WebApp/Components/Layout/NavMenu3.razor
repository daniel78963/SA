@* Agregamos la clase mini condicional *@
<div class="@NavMenuCssClass nav-scrollable @(IsMini ? "mini" : "")" @onclick="ToggleNavMenu">
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-door-fill"></i> <span class="menu-text">Inicio</span>
        </NavLink>
    </div>

    @* ÍTEM PADRE (Desplegable) *@
    @* Ejemplo de link desplegable *@
    <div class="nav-item px-3">
        <button class="nav-link w-100 text-start d-flex align-items-center" @onclick="ToggleProductsMenu">
            <i class="bi bi-box"></i>
            @* Fíjate en la clase menu-text aquí *@
            <span class="flex-grow-1 menu-text">Productos</span>
            <i class="bi bi-chevron-down chevron-icon" style="transition: transform 0.3s ease; transform: @(expandProducts ? "rotate(180deg)" : "rotate(0deg)")"></i>
        </button>
    </div>

    @* SUBNIVEL (Se muestra solo si expandProducts es true) *@
    @if (expandProducts)
    {
        <div class="nav-item px-3 submenu">
            <nav class="flex-column ps-4">
                @* ps-4 da la indentación (sangría) visual *@
                <div class="nav-item mb-0">
                    <NavLink class="nav-link submenu-link" href="ProductsBootstrap" Match="NavLinkMatch.All">
                        <i class="bi bi-list-ul"></i> Lista General
                    </NavLink>
                </div>
                <AuthorizeView Roles="Administrador, Gerente">
                    <Authorized>
                        <div class="nav-item mb-0">
                            <NavLink class="nav-link submenu-link" href="Products">
                                <i class="bi bi-plus-circle"></i> Lista General Restricted
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-item mb-0">
                    <NavLink class="nav-link submenu-link" href="products/create">
                        <i class="bi bi-person-fill"></i> Nuevo Producto
                    </NavLink>
                </div>
            </nav>
        </div>
    }

    @* ÍTEM PADRE (Desplegable) *@
    @* Ejemplo de link desplegable *@
    <div class="nav-item px-3">
        <button class="nav-link w-100 text-start d-flex align-items-center" @onclick="ToggleSystemMenu">
            <i class="bi bi-box"></i>
            @* Fíjate en la clase menu-text aquí *@
            <span class="flex-grow-1 menu-text">Sistema</span>
            <i class="bi bi-chevron-down chevron-icon" style="transition: transform 0.3s ease; transform: @(expandSistema ? "rotate(180deg)" : "rotate(0deg)")"></i>
        </button>
    </div>

    @* SUBNIVEL (Se muestra solo si expandProducts es true) *@
    @if (expandSistema)
    {
        <div class="nav-item px-3 submenu">
            <nav class="flex-column ps-4">
                @* ps-4 da la indentación (sangría) visual *@
                <div class="nav-item mb-0">
                    <NavLink class="nav-link submenu-link" href="products" Match="NavLinkMatch.All">
                        <i class="bi bi-list-ul"></i> Lista General
                    </NavLink>
                </div>
                <div class="nav-item mb-0">
                    <NavLink class="nav-link submenu-link" href="products/create">
                        <i class="bi bi-person-badge"></i> Nuevo Producto
                    </NavLink>
                </div>
            </nav>
        </div>
    }
    <AuthorizeView Roles="Administrador">
        <Authorized>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="security/users" Match="NavLinkMatch.All">
                    <i class="bi bi-person-badge"></i> <span class="menu-text">Users</span>
                </NavLink>
            </div>
        </Authorized>
    </AuthorizeView>

</div>

@code {
    // Agrega este parámetro para recibir el estado desde MainLayout
    // [Parameter]
    // public bool IsMini { get; set; }
    private bool _isMini;

    [Parameter]
    public bool IsMini
    {
        get => _isMini;
        set
        {
            // // Si el estado está cambiando (se presionó el botón ToggleSidebar)
            // if (_isMini != value)
            // {
            //     _isMini = value;

            //     // FORZAMOS A QUE LOS SUBMENÚS SE CIERREN
            //     expandProducts = false;
            //     expandSistema = false;
            // }
            if (_isMini != value)
            {
                _isMini = value;

                // IMPORTANTE: Ahora solo forzamos a cerrar los submenús
                // si la barra SE ESTÁ COMPRIMIENDO (valor true).
                if (_isMini)
                {
                    expandProducts = false;
                    expandSistema = false;
                }
            }
        }
    }

    // Este parámetro es obligatorio para que funcione el @bind-IsMini
    [Parameter]
    public EventCallback<bool> IsMiniChanged { get; set; }

    private string? currentUrl;
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    bool isExpandedSubmenu = false;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        // currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        // NavigationManager.LocationChanged += OnLocationChanged;

        // Nos suscribimos al evento. Cada vez que alguien llame a NotifyStateChanged(),
        // este componente se repintará.
        // ProductState.OnChange += StateHasChanged;
        ProductState.OnChange += StateHasChangedAsync;
        currentUrl = "";
    }

    private async void StateHasChangedAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        // NavigationManager.LocationChanged -= OnLocationChanged;

        // ¡CRÍTICO! Siempre desuscribirse en Dispose para evitar fugas de memoria
        // (que el componente siga vivo en memoria aunque el usuario haya cambiado de página)
        // ProductState.OnChange -= StateHasChanged;
        ProductState.OnChange -= StateHasChangedAsync;
    }




    IEnumerable<NavItem>? navItems;

    private async Task<Sidebar2DataProviderResult> Sidebar2DataProvider(Sidebar2DataProviderRequest request)
    {
        if (navItems is null)
            navItems = GetNavItems();

        await Task.Delay(2000);

        return await Task.FromResult(request.ApplyTo(navItems));
    }

    private IEnumerable<NavItem> GetNavItems()
    {
        navItems = new List<NavItem>
        {
            new NavItem { Id = "1", Href = "/getting-started", IconName = IconName.HouseDoorFill, Text = "Getting Started"},

            new NavItem { Id = "2", IconName = IconName.LayoutSidebarInset, Text = "Content", IconColor = IconColor.Primary },
            new NavItem { Id = "3", Href = "/icons", IconName = IconName.PersonSquare, Text = "Icons", ParentId="2"},

            new NavItem { Id = "4", IconName = IconName.ExclamationTriangleFill, Text = "Components", IconColor = IconColor.Success },
            new NavItem { Id = "5", Href = "/alerts", IconName = IconName.CheckCircleFill, Text = "Alerts", ParentId="4"},
            new NavItem { Id = "6", Href = "/breadcrumb", IconName = IconName.SegmentedNav, Text = "Breadcrumb", ParentId="4"},

            new NavItem { Id = "7", IconName = IconName.ListNested, Text = "Sidebar 2", ParentId="4"},
            new NavItem { Id = "701", Href = "/sidebar2/how-to-use", IconName = IconName.Dash, Text = "How to use", ParentId="7"},

            new NavItem { Id = "702", IconName = IconName.Dash, Text = "Examples", ParentId="7"},
            new NavItem { Id = "70201", Href = "/sidebar2", IconName = IconName.Dash, Text = "Nested levels", ParentId="702"},

            new NavItem { Id = "8", IconName = IconName.Grid, Text = "Grid", ParentId="4", IconColor = IconColor.Danger },
            new NavItem { Id = "801", Href = "/grid/#", IconName = IconName.Dash, Text = "How to use", ParentId="8"},
            new NavItem { Id = "802", IconName = IconName.Dash, Text = "Examples", ParentId="8"},
            new NavItem { Id = "80201", Href = "/grid/#", IconName = IconName.Dash, Text = "Filters", ParentId="802"},

            new NavItem { Id = "9", IconName = IconName.WindowPlus, Text = "Forms", IconColor = IconColor.Warning },
            new NavItem { Id = "10", Href = "/autocomplete", IconName = IconName.InputCursorText, Text = "Auto Complete", ParentId="9"},
            new NavItem { Id = "11", Href = "/currency-input", IconName = IconName.CurrencyDollar, Text = "Currency Input", ParentId="9"},
            new NavItem { Id = "12", Href = "/number-input", IconName = IconName.InputCursor, Text = "Number Input", ParentId="9"},
            new NavItem { Id = "13", Href = "/switch", IconName = IconName.ToggleOn, Text = "Switch", ParentId="9"},
        };

        return navItems;
    }



    // private bool collapseNavMenu = true;
    // private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // VARIABLE PARA EL SUBMENÚ
    private bool expandProducts = false;
    private bool expandSistema = false;

    // private void ToggleNavMenu()
    // {
    //     collapseNavMenu = !collapseNavMenu;
    // }

    // MÉTODO PARA ABRIR/CERRAR SUBMENÚ
    private async Task ToggleProductsMenu()
    {
        // expandProducts = !expandProducts;
        // expandSistema = false; // Cerrar el otro submenú si se abre este
        if (IsMini)
        {
            // Si estaba mini, le decimos al MainLayout que expanda la barra
            await IsMiniChanged.InvokeAsync(false);
            // Y nos aseguramos de que este submenú quede abierto al expandirse
            expandProducts = true;
        }
        else
        {
            // Comportamiento normal si ya estaba expandido
            expandProducts = !expandProducts;
            expandSistema = false; // Cerrar el otro submenú si se abre este
        }
    }

    private async Task ToggleSystemMenu()
    {
        // expandSistema = !expandSistema;
        // expandProducts = false; Cerrar el otro submenú si se abre este
        if (IsMini)
        {
            await IsMiniChanged.InvokeAsync(false);
            expandSistema = true;
        }
        else
        {
            expandSistema = !expandSistema;
            expandProducts = false; // Cerrar el otro submenú si se abre este
        }
    }
}

