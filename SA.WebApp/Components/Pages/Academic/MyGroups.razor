@* <!-- Filtros de Búsqueda -->
<div class="card shadow-sm border-1 mb-4">
    <div class="card-body bg-light rounded">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-bold text-secondary small">Programa Académico</label>
                <select class="form-select" @bind="filtroProgramaId">
                    <option value="">-- Seleccione su programa --</option>
                    @foreach (var prog in programasMock)
                    {
                        <option value="@prog.Id">@prog.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-secondary small">Periodo Académico</label>
                <select class="form-select" @bind="filtroPeriodoId" disabled="@string.IsNullOrEmpty(filtroProgramaId)">
                    <option value="">-- Seleccione periodo --</option>
                    @foreach (var per in periodosMock)
                    {
                        <option value="@per.Id">@per.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" @onclick="ConsultarGruposAsync"
                        disabled="@(string.IsNullOrEmpty(filtroProgramaId) || string.IsNullOrEmpty(filtroPeriodoId))">
                    <i class="bi bi-search me-2"></i> Consultar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Resultados / Empty State -->
@if (haConsultado)
{
    if (gruposEncontrados.Any())
    {
        <div class="card shadow-sm border-1">
            <div class="table-responsive card-body">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">Materia / Grupo</th>
                            <th>Profesor Asignado</th>
                            <th style="min-width: 250px;">Horarios y Aula</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var grupo in gruposEncontrados)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@grupo.MateriaNombre</div>
                                    <span class="badge bg-secondary opacity-75">Grupo: @grupo.CodigoGrupo</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle-small bg-primary text-white me-3" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: bold;">
                                            @GetInitials(grupo.ProfesorNombre)
                                        </div>
                                        <span>@(string.IsNullOrEmpty(grupo.ProfesorNombre) ? "Sin asignar" : grupo.ProfesorNombre)</span>
                                    </div>
                                </td>
                                <td>
                                    <!-- Renderizado moderno de Horarios -->
                                    <div class="d-flex flex-column gap-1 my-2">
                                        @if (grupo.Horarios.Any())
                                        {
                                            @foreach (var horario in grupo.Horarios)
                                            {
                                                <div class="d-inline-flex align-items-center bg-light border rounded px-2 py-1" style="font-size: 0.85rem;">
                                                    <i class="bi bi-clock text-primary me-2"></i>
                                                    <span class="fw-bold me-1">@horario.Dia:</span>
                                                    <span class="me-2">@horario.HoraInicio - @horario.HoraFin</span>
                                                    <span class="badge bg-info text-dark me-2">@horario.Ciclo</span>
                                                    <span class="border-start ps-2 text-muted">
                                                        <i class="bi bi-geo-alt me-1"></i>@horario.Aula
                                                    </span>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Sin horario asignado</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" title="Ver Plan de Aula">
                                            <i class="bi bi-journal-text"></i> <span class="d-none d-xl-inline ms-1">Plan</span>
                                        </button>
                                        <button class="btn btn-sm btn-outline-success" title="Ver Plan de Evaluación">
                                            <i class="bi bi-check2-square"></i> <span class="d-none d-xl-inline ms-1">Eval.</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Estado Vacío -->
        <div class="text-center py-5">
            <i class="bi bi-folder-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-secondary">No se encontraron grupos</h4>
            <p class="text-muted">No tienes asignaturas matriculadas para el periodo y programa seleccionado.</p>
        </div>
    }
} *@


