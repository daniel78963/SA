                                            {
                                                foreach (var h in grupo.Horarios)
                                                {
                                                    <div class="bg-light border rounded-pill px-3 py-1 text-secondary" style="font-size: 0.85rem;">
                                                        <i class="bi bi-clock me-1 text-primary"></i>
