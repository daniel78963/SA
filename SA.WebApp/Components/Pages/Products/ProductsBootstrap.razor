@page "/productsBootstrap"
@using SA.Application.DTOs
@using SA.Application.Interfaces
@using SA.WebApp.State

@inject IProductService ProductService
@inject ProductStateContainer ProductState
@inject NavigationManager NavigationManager

@inject IJSRuntime JSRuntime

@implements IDisposable
@rendermode InteractiveServer

<div class="mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4>Gestión de Productos</h4>

        @* Botón para navegar a la pantalla de creación *@
        <button class="btn btn-primary" @onclick="GoToCreate">
            <i class="bi bi-plus-circle-fill me-2"></i>Nuevo Producto
        </button>
    </div>

    @if (forecasts == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <Grid TItem="ProductDto"
              Class="table table-hover table-bordered table-striped"
              DataProvider="EmployeesDataProvider"
              AllowFiltering="true" AllowPaging="true" PageSize="5"
              RowKeySelector="(emp) => emp.Id"
              SelectedItemsChanged="OnSelectedItemsChanged"
              SelectionMode="GridSelectionMode.Multiple"
              Responsive="true">

            <GridColumns>
                <GridColumn TItem="ProductDto" HeaderText="Id" PropertyName="Id" SortKeySelector="item => item.Id">
                    @context.Id
                </GridColumn>
                <GridColumn TItem="ProductDto" HeaderText="Employee Name" PropertyName="Name" SortKeySelector="item => item.Name">
                    @context.Name
                </GridColumn>
                <GridColumn TItem="ProductDto" HeaderText="Price" PropertyName="Price" SortKeySelector="item => item.Price">
                    @context.Price
                </GridColumn>
                @*   <GridColumn TItem="ProductDto" HeaderText="DOJ" PropertyName="DOJ">
            @context.DOJ
        </GridColumn>
        <GridColumn TItem="ProductDto" HeaderText="Active" PropertyName="IsActive">
            @context.IsActive
        </GridColumn> *@
            </GridColumns>

        </Grid>
    }

    <br />
    @if (!ProductState.IsLoaded)
    {
        <div class="alert alert-info d-flex align-items-center">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            <span>Cargando productos...</span>
        </div>
    }
    else if (ProductState.Products.Count == 0)
    {
        <div class="alert alert-warning">
            No hay productos registrados. ¡Crea el primero!
        </div>
    }
    else
    {
        <h4>Gestión de Productos</h4>
        <div class="card shadow">
            <div class="card-body mt-1 mb-n5 ">
                <div class="d-flex justify-content-between align-items-center mb-0">
                    <h5>Productos</h5>
                    <button class="btn btn-primary btn-sm" @onclick="GoToCreate">
                        <i class="bi bi-plus-circle-fill me-2"></i>Nuevo Producto
                    </button>
                </div>
                @*    <h4>Productos</h4> *@
                <hr />
                @* HeaderRowCssClass = "bg-primary text-white border-bottom-0"
        FiltersRowCssClass = "bg-primary text-white bg-opacity-25 border-bottom-0" *@
                <Grid TItem="ProductDto" @ref="grid"
                      Class="table table-sm table-hover table-bordered table-striped"
                      DataProvider="ProductsDataProvider"
                      AllowFiltering="true" AllowPaging="true" PageSize="5"
                      PageSizeSelectorVisible="true"
                      PageSizeSelectorItems="@(new int[] { 5,10,20 })"
                      AllowSelection="true"
                      RowKeySelector="(emp) => emp.Id"
                      SelectedItemsChanged="OnSelectedItemsChanged"
                      SelectionMode="GridSelectionMode.Multiple"
                      Responsive="true">

                    <GridColumns>
                        <GridColumn TItem="ProductDto" HeaderText="Id" PropertyName="Id">
                            @context.Id
                        </GridColumn>
                        <GridColumn TItem="ProductDto" HeaderText="Employee Name" PropertyName="Name" class="col-md-6 align-self-center">
                            @context.Name
                        </GridColumn>
                        <GridColumn TItem="ProductDto" HeaderText="Price" PropertyName="Price" HeaderTextAlignment="Alignment.End" TextAlignment="Alignment.End">
                            @context.Price
                        </GridColumn>

                        @* <GridColumn TItem="ProductDto" HeaderText="Actions" Filterable="false" Sortable="false"> *@
                        @* <ChildContent>
                        @{
                            var currentItem = context as SampleData;
                            <Button Color="ButtonColor.Primary" @onclick="@(() => HandleEdit(currentItem.Id))">Edit</Button>
                            <Button Color="ButtonColor.Danger" @onclick="@(() => HandleDelete(currentItem.Id))">Delete</Button>
                        }
                    </ChildContent>
                    </GridColumn> *@
                        <GridColumn TItem="ProductDto" HeaderText="Actions" Filterable="false" Sortable="false">
                            <ChildContent>
                                <a href="/products/edit/@context.Id" class="btn btn-outline-primary btn-sm me-2">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-outline-danger btn-sm"
                                        title="Eliminar"
                                        @onclick="() => DeleteProduct(context.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </ChildContent>
                        </GridColumn>
                        @*   <GridColumn TItem="ProductDto" HeaderText="DOJ" PropertyName="DOJ">
            @context.DOJ
        </GridColumn>
        <GridColumn TItem="ProductDto" HeaderText="Active" PropertyName="IsActive">
            @context.IsActive
        </GridColumn> *@
                    </GridColumns>

                </Grid>
            </div>
        </div>
    }
    <div class="mt-3">
        Selected Items Count: @selectedEmployees.Count
    </div>

    <div class="mt-2">
        Selected Employees:
        <ul>
            @foreach (var emp in selectedEmployees)
            {
                <li>@emp.Name</li>
            }
        </ul>
    </div>

    <div class="card">
        <div class="card-header">
            Card Header
        </div>
        <div class="card-body">
            <h5 class="card-title">Card Title</h5>
            <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
        </div>
        <div class="card-footer">
            Card Footer
        </div>
    </div>

    <div class="card">
        @*  <div class="card-header">
           Productos
        </div> *@
        <div class="card-body">
            <h5 class="card-title">Card Title</h5>
            <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
        </div>
        @*  <div class="card-footer">
            Card Footer
        </div> *@
    </div>

    <Grid TItem="ProductDto" @ref="grid"
          Class="table table-hover table-bordered table-striped"
          DataProvider="ProductsDataProvider"
          AllowFiltering="true" AllowPaging="true" PageSize="5"
          PageSizeSelectorVisible="true"
          PageSizeSelectorItems="@(new int[] { 5,10,20 })"
          AllowSelection="true"
          RowKeySelector="(emp) => emp.Id"
          SelectedItemsChanged="OnSelectedItemsChanged"
          SelectionMode="GridSelectionMode.Multiple" EmptyText="No records to display"
          Responsive="true">
        <GridColumns>
            <GridColumn TItem="ProductDto" HeaderText="Id" PropertyName="Id">
                @context.Id
            </GridColumn>
            <GridColumn TItem="ProductDto" HeaderText="Employee Name" PropertyName="Name" class="col-md-6 align-self-center">
                @context.Name
            </GridColumn>
            <GridColumn TItem="ProductDto" HeaderText="Price" PropertyName="Price" HeaderTextAlignment="Alignment.End" TextAlignment="Alignment.End">
                @context.Price
            </GridColumn>
          @*   <GridColumn TItem="ProductDto" HeaderText="Actions" Filterable="false" Sortable="false">
                <ChildContent>
                    <a href="/products/edit/@context.Id" class="btn btn-outline-primary btn-sm ">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <button class="btn btn-outline-danger btn-sm"
                            title="Eliminar"
                            @onclick="() => DeleteProduct(context.Id)">
                        <i class="bi bi-trash"></i>
                    </button>
                </ChildContent>
            </GridColumn> *@
            <GridColumn TItem="ProductDto" HeaderText="Actions" >
                <ChildContent>
                    <a href="/products/edit/@context.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    @* <p><a href="#" class="link-primary link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover">Edit</a></p> *@
                </ChildContent> 
            </GridColumn>
        </GridColumns>
    </Grid>
</div>

