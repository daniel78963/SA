    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-SA_WebApp-a4cd93b6-378a-4f3f-ba4b-53103820f8e0</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
